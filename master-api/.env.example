# Local development. For hosting use your real HTTPS origin and a reverse proxy.
HOST=127.0.0.1
PORT=8787
PUBLIC_URL=http://127.0.0.1:8787
DATA_DIR=./data
# Only for isolated local tests. Keep false on the public master.
ALLOW_PRIVATE_RESOURCES=false
# Only enable behind your own loopback reverse proxy which replaces X-Forwarded-For.
TRUST_LOOPBACK_PROXY=false
